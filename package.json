{
  "name": "keurkado",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "epingles": "PANGOCAIRO_BACKEND=fc FONTCONFIG_FILE=\"$PWD/assets/polices/fonts.conf\" tsx scripts/epingles.mts",
    "build": "PANGOCAIRO_BACKEND=fc FONTCONFIG_FILE=\"$PWD/assets/polices/fonts.conf\" tsx scripts/epingles.mts && next build",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:sortie": "tsx --test tests/sortie/*.test.ts",
    "verifier-produits": "tsx scripts/verifier-produits.mts",
    "visuels-marque": "tsx scripts/visuels-marque.mts",
    "pinterest:auth": "node scripts/pinterest-auth.mjs",
    "pinterest:secrets": "node scripts/pinterest-secrets.mjs",
    "pinterest:publier": "node scripts/pinterest-publier.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "lucide-react": "^1.59.0",
    "marked": "^16.4.2",
    "next": "16.3.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "4.143.0"
  }
}
