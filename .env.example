# =====================================================================
# Keur Kado — variables d'environnement (toutes publiques, aucun secret)
# Copier ce fichier en .env.local pour le développement.
# En production, le site est construit par GitHub Actions (.github/workflows/deploy.yml)
# et publié sur Cloudflare Pages (keurkado.com). Secrets : CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID ;
# variable facultative : PINTEREST_VERIFY (Settings → Secrets and variables → Actions).
# =====================================================================

# --- Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Keur Kado
NEXT_PUBLIC_CONTACT_EMAIL=keurkado@toakeur.com
# Sous-dossier éventuel (vide en local et sur keurkado.com).
NEXT_PUBLIC_BASE_PATH=

# --- Programme Partenaires Amazon : identifiant ajouté aux liens « Voir sur Amazon » (par défaut keurkado-21).
NEXT_PUBLIC_AMAZON_TAG=

# --- Google AdSense : par défaut ca-pub-2680784147246798 ; vide = aucune publicité.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_RUBRIQUE=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=

# --- Pinterest : valeur « content » de la balise p:domain_verify (revendication du domaine).
NEXT_PUBLIC_PINTEREST_VERIFY=

# --- Informations légales (mentions légales, conditions d'utilisation)
NEXT_PUBLIC_LEGAL_COMPANY_NAME=
NEXT_PUBLIC_LEGAL_FORM=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_SIRET=
NEXT_PUBLIC_LEGAL_RCS=
NEXT_PUBLIC_LEGAL_VAT=
NEXT_PUBLIC_LEGAL_DIRECTOR=
NEXT_PUBLIC_LEGAL_PHONE=
# Hébergeur (par défaut : Cloudflare).
NEXT_PUBLIC_LEGAL_HOST=
NEXT_PUBLIC_LEGAL_HOST_NAME=
